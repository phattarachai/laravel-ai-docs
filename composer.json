{
    "name": "phattarachai/laravel-ai-docs",
    "description": "Render a folder of markdown — your .ai/documents/ tree — as a searchable documentation site inside your Laravel app.",
    "keywords": [
        "laravel",
        "documentation",
        "markdown",
        "wiki",
        "inertia",
        "mermaid"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Phattarachai Chaimongkol",
            "email": "phatchai28@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "league/commonmark": "^2.4",
        "symfony/finder": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "tempest/highlight": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\AiDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\AiDocs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phattarachai\\AiDocs\\AiDocsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    }
}
